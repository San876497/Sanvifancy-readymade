------MultipartBoundary--c4Q9CCPqV69gyrOVcFDcEqcO3mmnwuXfmqL6EITiZG----
Content-Type: text/css
Content-Transfer-Encoding: binary
Content-Location: cid:css-b62f0de2-a193-445f-a194-0636c28b806d@mhtml.blink

@charset "utf-8";

a:focus-visible, button:focus-visible { outline: 2px solid var(--gold); outline-offset: 4px; }

@media (prefers-reduced-motion: reduce) {
  html { scroll-behavior: auto; }
  *, ::before, ::after { animation-duration: 0.01ms !important; animation-iteration-count: 1 !important; transition-duration: 0.01ms !important; }
  .collection-card { transform: none !important; }
}

:root { --ink: #0f0c0d; --wine: #8b263e; --gold: #d4af37; --cream: #fdf9f1; --muted: #b8aaa1; --line: rgba(212,175,55,.22); }

* { box-sizing: border-box; }

html { scroll-behavior: smooth; }

body { color: var(--cream); }

a, button { font: inherit; }

button { cursor: pointer; }

.site-shell { overflow: hidden; background: radial-gradient(circle at 82% 15%,rgba(139,38,62,.22),transparent 28%),var(--ink); min-height: 100vh; }

.site-header { position: fixed; top: 0px; z-index: 30; width: 100%; height: 78px; padding: 0px 6vw; display: flex; align-items: center; justify-content: space-between; background: rgba(15, 12, 13, 0.82); border-bottom: 1px solid var(--line); backdrop-filter: blur(16px); }

.brand { display: flex; gap: 11px; align-items: center; color: var(--cream); text-decoration: none; }

.brand-mark { width: 35px; height: 35px; display: grid; place-items: center; border: 1px solid var(--gold); color: var(--gold); border-radius: 50%; }

.brand b { font-family: "Playfair Display", serif; font-size: 21px; font-weight: 500; display: block; }

.brand em { font-style: normal; font-size: 8px; letter-spacing: 2px; color: var(--gold); display: block; margin-top: 1px; }

.nav-links { display: flex; align-items: center; gap: 31px; }

.nav-links a { color: rgb(214, 203, 194); text-decoration: none; font-size: 12px; transition: color 0.25s; }

.nav-links a:hover { color: var(--gold); }

.nav-cta { border: 1px solid var(--line); padding: 11px 16px; display: flex; align-items: center; gap: 8px; color: var(--gold) !important; }

.menu-toggle { display: none; color: var(--cream); background: none; border: 0px; }

.hero { min-height: 800px; max-width: 1400px; margin: auto; padding: 170px 7vw 90px; display: grid; grid-template-columns: 1.03fr 0.97fr; align-items: center; position: relative; }

.hero-content { position: relative; z-index: 2; }

.eyebrow { display: flex; align-items: center; gap: 13px; color: var(--gold); font-size: 10px; letter-spacing: 3px; }

.eyebrow > span:first-child, .eyebrow > span:last-child { width: 34px; height: 1px; background: var(--gold); display: inline-block; }

.eyebrow.left { gap: 10px; }

.eyebrow.left > span:first-child { width: 22px; }

.hero h1 { font-family: "Playfair Display", serif; font-size: clamp(50px, 6.5vw, 91px); line-height: 0.99; font-weight: 500; letter-spacing: -3px; margin: 25px 0px; }

.hero h1 i, h2 i { color: var(--gold); font-weight: 500; }

.hero-lede { max-width: 450px; color: var(--muted); line-height: 1.8; font-size: 14px; }

.hero-actions { display: flex; gap: 23px; align-items: center; margin: 33px 0px 56px; }

.gold-button { background: var(--gold); color: var(--ink); padding: 14px 20px; text-decoration: none; font-size: 12px; font-weight: 700; letter-spacing: 0.2px; display: inline-flex; align-items: center; gap: 11px; border: 1px solid var(--gold); transition: transform 0.25s, background 0.25s; }

.gold-button:hover { transform: translateY(-3px); background: rgb(237, 206, 105); }

.play-button { background: transparent; color: var(--cream); border: 0px; display: flex; align-items: center; gap: 10px; font-size: 12px; }

.play-button span { height: 30px; width: 30px; border: 1px solid var(--gold); color: var(--gold); border-radius: 50%; display: grid; place-items: center; padding-left: 2px; }

.hero-proof { display: flex; align-items: center; gap: 14px; color: var(--cream); }

.proof-avatars { display: flex; }

.proof-avatars span { width: 29px; height: 29px; display: grid; place-items: center; border-radius: 50%; font-size: 10px; background: var(--wine); border: 2px solid var(--ink); margin-left: -7px; }

.proof-avatars span:first-child { margin: 0px; background: rgb(212, 175, 55); color: var(--ink); }

.hero-proof strong, .hero-proof small { display: block; font-size: 11px; }

.hero-proof small { color: var(--muted); margin-top: 4px; }

.hero-stage { position: relative; height: 580px; display: grid; place-items: center; perspective: 1000px; }

.stage-glow { width: 390px; height: 390px; background: var(--wine); filter: blur(80px); opacity: 0.45; position: absolute; }

.hero-image-frame { height: 520px; width: min(355px, 78vw); border: 1px solid rgba(212, 175, 55, 0.55); padding: 11px; transform: rotate(4deg); position: relative; z-index: 1; background: rgb(38, 21, 26); box-shadow: rgb(0, 0, 0) 20px 30px 80px; }

.hero-image-frame img { height: 100%; width: 100%; object-fit: cover; object-position: center center; filter: saturate(1.08); }

.frame-label { position: absolute; bottom: 25px; left: 26px; background: rgba(15, 12, 13, 0.82); padding: 10px 14px; display: flex; gap: 8px; align-items: center; color: var(--gold); font-size: 9px; letter-spacing: 2px; }

.floating-note { position: absolute; z-index: 2; background: rgba(28, 20, 21, 0.84); border: 1px solid var(--line); backdrop-filter: blur(14px); padding: 14px 18px; box-shadow: rgba(0, 0, 0, 0.4) 0px 15px 35px; }

.note-top { top: 108px; right: 3%; transform: rotate(-4deg); }

.note-bottom { bottom: 80px; left: 4%; display: flex; gap: 10px; align-items: center; color: var(--gold); font-size: 11px; line-height: 1.45; transform: rotate(-5deg); }

.floating-note small, .floating-note strong { display: block; }

.floating-note small { font-size: 9px; color: var(--gold); letter-spacing: 2px; margin-bottom: 5px; }

.floating-note strong { font-family: "Playfair Display"; font-size: 20px; }

.marquee { overflow: hidden; border-block: 1px solid var(--line); background: rgb(29, 18, 22); padding: 17px 0px; }

.marquee div { display: flex; justify-content: space-around; min-width: 950px; color: rgb(228, 195, 106); font-family: "Playfair Display"; font-size: 16px; font-style: italic; }

.marquee i { font-style: normal; color: var(--wine); font-size: 11px; margin: 0px 25px; }

.section { max-width: 1240px; margin: auto; padding: 130px 5vw; }

.section-heading { display: flex; align-items: end; justify-content: space-between; gap: 60px; }

.section-heading h2, .story-copy h2, .visit-section h2 { font-family: "Playfair Display"; font-weight: 500; letter-spacing: -1px; line-height: 1.05; font-size: clamp(38px, 4.3vw, 61px); margin: 22px 0px; }

.section-heading p { color: var(--muted); font-size: 13px; line-height: 1.8; max-width: 280px; padding-bottom: 8px; }

.filter-row { display: flex; gap: 9px; align-items: center; margin: 52px 0px 25px; flex-wrap: wrap; }

.filter-row button { color: var(--muted); background: transparent; border: 1px solid var(--line); padding: 10px 16px; font-size: 11px; transition: background 0.2s, color 0.2s; }

.filter-row button.active, .filter-row button:hover { background: var(--gold); border-color: var(--gold); color: var(--ink); }

.filter-row > svg { color: var(--gold); margin-left: 4px; }

.collection-grid { display: grid; grid-template-columns: repeat(4, 1fr); gap: 16px; perspective: 1200px; }

.collection-card { min-width: 0px; padding: 0px; text-align: left; background: rgb(33, 21, 24); border: 1px solid var(--line); position: relative; overflow: hidden; aspect-ratio: 0.73 / 1; transform-style: preserve-3d; }

.collection-card img { width: 100%; height: 100%; object-fit: cover; opacity: 0.82; transition: transform 0.6s, opacity 0.3s; }

.collection-card:hover img { transform: scale(1.07); opacity: 1; }

.card-shine { position: absolute; inset: 0px; background: linear-gradient(150deg, rgba(255, 255, 255, 0.16), transparent 35%, rgba(0, 0, 0, 0.7) 80%); }

.card-copy { position: absolute; bottom: 18px; left: 18px; right: 12px; color: white; }

.card-copy small { display: block; color: var(--gold); font-size: 9px; letter-spacing: 2px; margin-bottom: 7px; }

.card-copy strong { font-family: "Playfair Display"; font-size: 23px; font-weight: 500; display: block; }

.card-copy span { font-size: 10px; color: rgb(221, 221, 221); display: block; margin-top: 4px; }

.card-arrow { position: absolute; right: 14px; top: 14px; color: var(--gold); }

.collection-foot { display: flex; justify-content: space-between; margin-top: 26px; font-size: 11px; color: var(--muted); }

.collection-foot i { display: inline-block; width: 6px; height: 6px; background: var(--gold); border-radius: 50%; margin-right: 8px; }

.collection-foot a { color: var(--gold); text-decoration: none; display: flex; gap: 7px; align-items: center; }

.story-section { max-width: 1400px; margin: auto; padding: 100px 7vw 145px; display: grid; grid-template-columns: 1fr 1fr; gap: 9vw; align-items: center; }

.story-image { position: relative; border: 1px solid var(--line); padding: 11px; transform: rotate(-2deg); background: rgb(36, 22, 27); }

.story-image img { width: 100%; display: block; }

.story-image button { position: absolute; bottom: 27px; right: 26px; border: 1px solid var(--gold); background: rgba(15, 12, 13, 0.88); color: var(--gold); padding: 12px 15px; font-size: 11px; display: flex; gap: 8px; align-items: center; }

.story-copy p { color: var(--muted); line-height: 1.9; font-size: 13px; max-width: 440px; }

.signature { color: var(--gold); font-family: "Playfair Display"; font-style: italic; font-size: 20px; margin-top: 26px; }

.signature small { display: block; font-family: "DM Sans"; font-style: normal; font-size: 9px; letter-spacing: 2px; color: var(--muted); margin-top: 6px; }

.visit-section { background: linear-gradient(120deg, rgb(36, 17, 24), rgb(23, 16, 17)); border-block: 1px solid var(--line); padding: 95px 12vw; display: flex; justify-content: space-between; gap: 50px; }

.visit-section h2 { margin-bottom: 0px; }

.visit-info { min-width: 370px; padding-top: 14px; }

.info-line { display: flex; gap: 15px; margin-bottom: 24px; color: var(--gold); }

.info-line span { color: var(--muted); font-size: 12px; line-height: 1.7; }

.info-line b { display: block; color: var(--cream); font-size: 11px; margin-bottom: 3px; }

.visit-actions { display: flex; gap: 11px; margin-top: 32px; }

.outline-button { border: 1px solid var(--line); color: var(--cream); padding: 14px 18px; text-decoration: none; font-size: 12px; display: flex; align-items: center; gap: 8px; }

.outline-button:hover { border-color: var(--gold); }

footer { padding: 28px 7vw; display: flex; align-items: center; justify-content: space-between; color: rgb(120, 109, 104); font-size: 10px; border-top: 1px solid rgba(255, 255, 255, 0.04); }

footer .brand b { font-size: 16px; color: var(--cream); }

footer a { color: var(--gold); text-decoration: none; }

.modal-backdrop { position: fixed; inset: 0px; z-index: 50; display: grid; place-items: center; background: rgba(7, 5, 5, 0.84); padding: 25px; backdrop-filter: blur(10px); }

.modal { background: rgb(33, 21, 24); border: 1px solid var(--gold); width: min(770px, 100%); display: grid; grid-template-columns: 1fr 1fr; position: relative; box-shadow: rgb(0, 0, 0) 0px 20px 70px; }

.modal > img { height: 410px; width: 100%; object-fit: cover; }

.modal-copy { padding: 55px 32px; }

.modal-copy h3 { font-family: "Playfair Display"; font-size: 37px; font-weight: 500; color: var(--cream); margin: 15px 0px; }

.modal-copy p { color: var(--muted); font-size: 13px; line-height: 1.7; margin-bottom: 25px; }

.modal-close { position: absolute; right: 12px; top: 12px; z-index: 2; border: 0px; background: rgba(15, 12, 13, 0.72); color: var(--cream); padding: 7px; display: grid; place-items: center; }

.banner-modal { width: min(1120px, 100%); display: block; padding: 10px; }

.banner-modal img { display: block; width: 100%; height: auto; max-height: 80vh; object-fit: contain; }

.banner-modal .modal-close { top: 19px; right: 19px; }

@media (max-width: 850px) {
