.chat-v2-stream-word, .chat-v2-stream-block { opacity: 0; filter: blur(4px); animation-name: chat-v2-stream-word-in; animation-timing-function: cubic-bezier(0.32, 0.72, 0, 1); animation-fill-mode: forwards; will-change: opacity, filter; }

.chat-v2-stream-word { display: inline-block; }

@keyframes chat-v2-stream-word-in { 
  100% { opacity: 1; filter: blur(0px); }
}

.chat-v2-streamdown-trajectory { overflow-wrap: anywhere; }

.chat-v2-streamdown-trajectory [data-streamdown="paragraph"] { line-height: 1.75rem; }

.chat-v2-streamdown-trajectory [data-streamdown="strong"] { font-weight: 600; }

.chat-v2-streamdown-trajectory [data-streamdown="heading-1"] { margin-top: 1.25rem; margin-bottom: 0.25rem; color: var(--sys-color-text-primary); font-size: 1.5rem; font-weight: 700; line-height: 1.2; }

.chat-v2-streamdown-trajectory [data-streamdown="heading-2"] { margin-top: 1rem; margin-bottom: 0.25rem; color: var(--sys-color-text-primary); font-size: 1.25rem; font-weight: 600; line-height: 1.375; }

.chat-v2-streamdown-trajectory [data-streamdown="heading-3"] { margin-top: 0.75rem; margin-bottom: 0.125rem; color: var(--sys-color-text-primary); font-size: 1.125rem; font-weight: 600; line-height: 1.375; }

.chat-v2-streamdown-trajectory [data-streamdown="heading-4"] { margin-top: 0.75rem; margin-bottom: 0.125rem; color: var(--sys-color-text-primary); font-size: 1rem; font-weight: 600; line-height: 1.5; }

.chat-v2-streamdown-trajectory [data-streamdown="heading-5"] { margin-top: 0.5rem; color: var(--sys-color-text-primary); font-size: 0.875rem; font-weight: 600; }

.chat-v2-streamdown-trajectory [data-streamdown="heading-6"] { margin-top: 0.5rem; color: var(--sys-color-text-secondary); font-size: 0.75rem; font-weight: 600; letter-spacing: 0px; text-transform: uppercase; }

.chat-v2-streamdown-trajectory [data-streamdown="unordered-list"], .chat-v2-streamdown-trajectory [data-streamdown="ordered-list"] { padding-left: 1.25rem; line-height: 1.75rem; }

.chat-v2-streamdown-trajectory [data-streamdown="list-item"] { line-height: 1.75rem; }

.chat-v2-streamdown-trajectory [data-streamdown="inline-code"] { font-family: var(--font-jetbrains, "JetBrains Mono", monospace); font-size: 0.875rem; }

.chat-v2-streamdown-trajectory [data-streamdown="code-block"], .chat-v2-streamdown-trajectory [data-streamdown="code-block-body"], .chat-v2-streamdown-trajectory [data-streamdown="code-block-body"] pre { overflow-wrap: anywhere; white-space: pre-wrap; }

.chat-v2-streamdown-trajectory [data-streamdown="code-block"], .chat-v2-streamdown-trajectory [data-streamdown="code-block-body"] code { font-family: var(--font-jetbrains, "JetBrains Mono", monospace); font-size: 0.875rem; }

.chat-v2-streamdown-trajectory [data-streamdown="blockquote"] { border-left: 2px solid var(--chat-v2-panel-border); color: var(--sys-color-text-secondary); }

.chat-v2-streamdown-trajectory [data-streamdown="horizontal-rule"] { margin-top: 0.75rem; margin-bottom: 0.75rem; border-color: var(--chat-v2-panel-border); }

.chat-v2-streamdown-trajectory [data-streamdown="table-wrapper"] { max-width: 100%; }

.chat-v2-streamdown-trajectory [data-streamdown="table-header-cell"] { color: var(--sys-color-text-secondary); font-size: 0.75rem; font-weight: 600; text-transform: uppercase; }

@media (prefers-reduced-motion: reduce) {
  .chat-v2-stream-word, .chat-v2-stream-block { animation: auto ease 0s 1 normal none running none !important; opacity: 1 !important; filter: none !important; transform: none !important; }
}

.bg-ds-accent-glass { background-color: var(--sys-color-bg-accent-glass); }

.bg-ds-surface-glass, .hover\:bg-ds-surface-glass:hover { background-color: var(--sys-color-bg-surface-glass); }

.chat-v2-ask-human-gradient-border { position: relative; }

.chat-v2-ask-human-gradient-border::before { content: ""; position: absolute; inset: 0px; pointer-events: none; border-radius: inherit; padding: 1px; background: var(--chat-v2-ask-human-border-gradient); mask: linear-gradient(rgb(255, 255, 255) 0px, rgb(255, 255, 255) 0px) content-box exclude, linear-gradient(rgb(255, 255, 255) 0px, rgb(255, 255, 255) 0px); }

@keyframes wingman-subscription-recommended-shine { 
  0% { opacity: 0; transform: translate(-28px) rotate(36deg); }
  18% { opacity: 1; }
  52% { opacity: 1; }
  100% { opacity: 0; transform: translate(128px) rotate(36deg); }
}

.wingman-subscription-recommended-shine { left: 0px; animation: 1.45s ease-in-out 0s infinite normal none running wingman-subscription-recommended-shine; }

.wingman-onboarding-v2-claim-shine { left: 0px; animation: 1.45s ease-in-out 0s infinite normal none running wingman-onboarding-v2-claim-shine; }

@keyframes wingman-onboarding-v2-claim-shine { 
  0% { opacity: 0; transform: translate(-32px, -50%) rotate(36deg); }
  18% { opacity: 1; }
  52% { opacity: 1; }
  100% { opacity: 0; transform: translate(130px, -50%) rotate(36deg); }
