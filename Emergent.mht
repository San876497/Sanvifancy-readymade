  .nav-links.open { display: flex; }
  .nav-cta { justify-content: center; }
  .hero { grid-template-columns: 1fr; padding-top: 120px; min-height: auto; }
  .hero-stage { height: 450px; grid-row: 1; }
  .hero-content { grid-row: 2; padding-bottom: 50px; }
  .hero h1 { font-size: 62px; }
  .hero-image-frame { height: 390px; }
  .note-top { right: 0px; }
  .note-bottom { left: 0px; }
  .section-heading, .story-section, .visit-section { display: block; }
  .section-heading p { margin-top: 25px; }
  .collection-grid { grid-template-columns: repeat(2, 1fr); }
  .story-section { padding-top: 40px; }
  .story-copy { padding-top: 65px; }
  .visit-section { padding: 75px 7vw; }
  .visit-info { min-width: 0px; margin-top: 25px; }
  .modal { grid-template-columns: 1fr; }
  .modal > img { height: 300px; }
  .modal-copy { padding: 30px; }
  .collection-foot { gap: 20px; flex-direction: column; }
  footer { gap: 20px; flex-wrap: wrap; }
}

@media (max-width: 480px) {
